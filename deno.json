{
  "name": "@rntgspr/google-chat-deno",
  "version": "0.0.1",
  "exports": "./src/app.ts",
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.desktop"
    ]
  },
  "lint": {},
  "desktop": {
    "app": {
      "name": "Google Chat Deno",
      "identifier": "com.rntgspr.google-chat-deno",
      "icons": {
        "macos": "./assets/GoogleChat.icns"
      }
    },
    "backend": "cef",
    "output": {
      "macos": "./dist/GoogleChatDeno"
    }
  },
  "imports": {
    "@/": "./src/"
  },
  "fmt": {
    "useTabs": false,
    "indentWidth": 2,
    "newLineKind": "lf",
    "semiColons": false,
    "lineWidth": 120
  }
}
